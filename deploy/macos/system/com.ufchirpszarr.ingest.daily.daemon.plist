<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ufchirpszarr.ingest.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/mohammadwael/repos/uf-chirps-zarr && deploy/macos/system/wait-for-docker.sh && docker compose run --rm ingestion incremental -y --max-days 30</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mohammadwael/repos/uf-chirps-zarr/logs/launchd-ingest-daily.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mohammadwael/repos/uf-chirps-zarr/logs/launchd-ingest-daily.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin</string>
    </dict>
</dict>
</plist>
