<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ufchirpszarr.ingest.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/mohammadwael/repos/uf-chirps-zarr && docker compose run --rm ingestion incremental -y --max-days 30</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/mohammadwael/repos/uf-chirps-zarr/logs/launchd-ingest.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mohammadwael/repos/uf-chirps-zarr/logs/launchd-ingest.err.log</string>
</dict>
</plist>
